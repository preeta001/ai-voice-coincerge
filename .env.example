# Claude (default). Get a key at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-...

# Or run on Groq's free tier: https://console.groq.com/keys
# CONCIERGE_PROVIDER=groq
# GROQ_API_KEY=gsk_...

# Optional. Defaults: claude-opus-5 (anthropic), qwen/qwen3.8-27b (groq).
# CONCIERGE_MODEL=claude-haiku-5-5
# CONCIERGE_MAX_TURNS=8

# Call history store (docker run -d -p 6379:6379 redis:7)
# REDIS_URL=redis://localhost:6379/0
# CONCIERGE_CALL_TTL=1800
